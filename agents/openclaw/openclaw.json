// OpenClaw config for the personal agent (JSON5), baked into the image at
// ~/.openclaw/openclaw.json. The sandbox reaches Steward as host.openshell.internal.
// ${STEWARD_PASS_PERSONAL} holds the OpenShell placeholder, never the real pass.
{
  agents: {
    defaults: {
      // <provider>/<model id>. Steward forces the personal pass's model anyway
      // (config/steward.yaml); keep this in step.
      model: { primary: "steward/nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B" },
    },
  },
  models: {
    mode: "merge",
    providers: {
      steward: {
        baseUrl: "http://host.openshell.internal:8000/v1",
        apiKey: "${STEWARD_PASS_PERSONAL}",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B",
            name: "Nemotron small via Steward",
            reasoning: true,
            input: ["text"],
            // Served context length from GET /v1/models?verbose=true (Part F, 21 Oct 2026).
            contextWindow: 262144,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
  tools: {
    // OpenClaw treats a provider on a private address as a local model and hides tools behind
    // tool_search / tool_call. Nano then often calls the bare MCP tool name, which fails, so
    // expose the tools directly.
    toolSearch: false,
    // agent exec defaults to the "coding" profile (files, shell and more, about 31k prompt
    // tokens per call in Phase 0). The personal agent only needs Steward's tools: start from
    // "minimal", add the steward server's tools and deny the two minimal ones.
    profile: "minimal",
    alsoAllow: ["steward__*"],
    deny: ["session_status", "gateway"],
  },
  mcp: {
    servers: {
      steward: {
        url: "http://host.openshell.internal:8000/tools/personal/mcp",
        // OpenClaw uses SSE when transport is omitted.
        transport: "streamable-http",
        headers: { Authorization: "Bearer ${STEWARD_PASS_PERSONAL}" },
        connectionTimeoutMs: 10000,
        // The reply tool answers at once, but leave room for slow upstream tools.
        requestTimeoutMs: 180000,
      },
    },
  },
}
