# Copy to .env and fill in yourself. Never commit .env.

# Nebius Token Factory key. Only Steward reads it; it never goes into an agent or a sandbox.
NEBIUS_API_KEY=

# Passes: random tokens that tell Steward which agent is calling. Not provider keys.
# Generate each with: python -c "import secrets; print('stw_' + secrets.token_urlsafe(24))"
STEWARD_PASS_WORK=
STEWARD_PASS_PERSONAL=

# Owner token for the admin API and the console (Phase 1). Generate it like the passes.
STEWARD_OWNER_TOKEN=

# Policy file (agents, models, tools, contacts) and the flight log database (Phase 1).
# Models per agent now live in the policy file, not here.
STEWARD_POLICY=config/steward.yaml
STEWARD_DB_PATH=var/steward.db

# Bearer key for the Hermes API server inside its sandbox (Phase 0 Part I)
HERMES_API_KEY=

# Demo dates: replay, next-monday, or an ISO date that is a Monday
STEWARD_DEMO_ANCHOR=replay

# Phase 2
# Tavily key for web_search and web_extract. Without it the web tools read the fixture pages.
TAVILY_API_KEY=
# Optional: tavily or fixture, to force one web backend.
STEWARD_WEB_BACKEND=
# Optional: the public copy of the poisoned station guide (GitHub Pages).
STEWARD_DEMO_PAGE_URL=
# Signs approval links (30 minutes). Generate it like the passes. Links are off without it.
STEWARD_APPROVAL_SECRET=
# Where approval links point; the console through the SSH tunnel by default.
STEWARD_PUBLIC_URL=http://localhost:8000
# Telegram approval cards, off unless both are set (Phase 2 Part I).
TELEGRAM_BOT_TOKEN=
STEWARD_TELEGRAM_OWNER_ID=
